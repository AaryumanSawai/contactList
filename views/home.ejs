<html>
    <head>
         <title>
            <%=title%>
         </title>
         <script src="https://kit.fontawesome.com/6e3578b6ee.js" crossorigin="anonymous"></script>
         <link rel = "stylesheet" href="/CSS/home.css">
    </head>
<body>
    <h1> <i class="fa-solid fa-address-book"></i> My Contacts List</h1>
    <div>
        <ul>
            <% for(let i of contact_list){
                %>
                <li class = "contact" id="item">
                    <div class="details">
                        <p><%= i.name %> </p>
                        <p style="margin-right: -600px; margin-top: -30px;"><%= i.phone %></p>
                    </div>
                   <div class="delete_button ">
                    <a href="/delete-contact/<%= i._id %>">
                        
                        <i class="fa-solid fa-circle-xmark"></i>
                    </a>
                   </div>
                    
                </li>
                <%
            }%>

        </ul>
        <!-- <form action="/delete-contact" method="post">
            <% for(let i of contact_list){ %>
                <input type="checkbox" name="<%=i.name%>" id="<%=i.name%>">
                <label for="<%=i.name%>"> <%= i.name%>  <%= i.phone%></label>
                <br>
            <% } %>
            <hr>
            <button type="submit">Delete Selected Items.</button>
        </form> -->
    </div>
    <form action="/create-contact" method = "post" >
        <input type = "text" name="name" placeholder="Enter Name" required>
        <input type = "number" name="phone" placeholder="Enter Phone" required>
        <button type="submit" id="button">Add</button>

    </form>
    <script type="text/javascript" src="/JS/home.js"></script>
</body>
</html>